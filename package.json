{
    "name": "paper",
    "version": "2.5.0",
    "description": "Discord bot, Paper📄, is a multipurpose bot with music, moderation, fun, and utility features.",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
        "build:watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "lint:fix": "eslint ./src --ext .ts --fix",
        "test": "pnpm build && mocha dist/__test__/**/*.test.js --timeout 10000",
        "test:redis": "pnpm build && mocha dist/__test__/redis.test.js --timeout 10000"
    },
    "type": "module",
    "main": "dist/index.js",
    "keywords": [
        "discord",
        "discord bot",
        "discord.js"
    ],
    "author": "Paper1988",
    "license": "MIT",
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "@fastify/cors": "^11.3.0",
        "@iamtraction/google-translate": "^2.0.1",
        "@noble/ciphers": "^2.2.0",
        "@sentry/integrations": "^7.114.0",
        "@sentry/node": "^10.68.0",
        "@sentry/tracing": "^7.120.4",
        "@snazzah/davey": "^0.1.12",
        "apexify.js": "^5.4.5",
        "ascii-table": "^0.0.9",
        "axios": "^1.18.1",
        "chai": "^6.2.2",
        "chalk": "^5.6.2",
        "concurrently": "^9.2.4",
        "dargs": "^8.1.0",
        "discord-arts": "^0.7.1",
        "discord-gamecord": "^4.4.4",
        "discord-giveaways": "^6.0.1",
        "discord.js": "^14.27.0",
        "discord.js-anticrash": "^5.2.5",
        "dotenv": "^17.4.2",
        "eslint": "^10.8.0",
        "fastify": "^5.10.0",
        "genius-lyrics": "^4.4.7",
        "glob": "^13.0.6",
        "husky": "^9.1.7",
        "i18n": "^0.15.3",
        "ioredis": "^5.11.1",
        "jsonwebtoken": "^9.0.3",
        "mal-scraper": "^2.13.2",
        "mediaplex": "^1.0.0",
        "mocha": "^11.7.6",
        "mongodb": "^7.5.0",
        "mongoose": "^9.8.1",
        "moonlink.js": "^5.2.0",
        "ms": "^2.1.3",
        "node-cron": "^4.6.0",
        "os-utils": "^0.0.14",
        "pidusage": "^4.0.1",
        "uuid": "^13.0.2"
