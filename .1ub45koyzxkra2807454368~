const { Client, CommandInteraction, EmbedBuilder, ActionRowBuilder, MessageButton, SlashCommandBuilder } = require("discord.js")

module.exports = {
    data: new SlashCommandBuilder()
        .setName("invite")
        .setDescription("邀請我加入你的伺服器!"),
    /**
     * @param {Client} client
     * @param {CommandInteraction} interaction
     */
    async execute(interaction, client) {
        const Invite = new EmbedBuilder()
            .setTitle("邀請我!")
            .setDescription("我是一個很酷的 Discord Bot，不是嗎？\n使用下面的按鈕邀請我加入您的伺服器或加入我們的支援伺服器！\n\n保持安全 👋")
            .setColor("BLUE")
            .setThumbnail(client.user.displayAvatarURL())

        let row = new ActionRowBuilder().addComponents([
            new ButtonBuilder()
            .setURL("https://discord.com/api/oauth2/authorize?client_id=***REMOVED***&permissions=1644971945463&scope=bot%20applications.commands")
            .setLabel("邀請我!")
            .setStyle("LINK"),

            new ButtonBuilder()
            .setURL("https://discord.gg/6qCTEer4pT")
            .setLabel("支援伺服器")
            .setStyle("LINK")
        ]);
        await interaction.reply({ embeds: [Invite], components: [row] });
    }
}