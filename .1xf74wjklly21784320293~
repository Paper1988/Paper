const { PermissionFlagsBits, CommandInteraction, SlashCommandBuilder, EmbedBuilder } = require("discord.js");
const DB = require("../../../Structures/Schemas/AntiAlt");

module.exports = {
    data: new SlashCommandBuilder()
        .setName("anti-alt")
        .setDescription("設置或重置日誌頻道")
        .setDefaultMemberPermissions(PermissionFlagsBits.Administrator)
        .addSubcommand((sub) =>
            sub
            .setName("setup")
            .setDescription("設置伺服器反alt日誌頻道")
            .addChannelOption((options) =>
                options
                .setName("channel")
                .setDescription("選擇將伺服器反alt日誌發送到的頻道")
                .setRequired(true)
            )
        )
        .addSubcommand((sub) => sub.setName("reset").setDescription("還原至原始設定")),
    usage: "/anti-alt (setup, channel)",
    /**
     *
     * @param {GuildMember} member
     * @param {CommandInteraction} interaction
     */
    async execute(interaction) {
        try {
            const options = interaction.options;
            const { guild } = interaction;

            switch (options.getSubcommand()) {
                case "setup":
                    {
                        const LogsChannel = options.getChannel("channel");

                        await DB.findOneAndUpdate({ GuildID: guild.id }, {
                            LogsChannel: LogsChannel.id,
                        }, {
                            new: true,
                            upsert: true,
                        }).catch((err) => console.log(err));

                        const LogsSetup = new EmbedBuilder()
                            .setDescription(
                                "✅ | 成功設置反alt伺服器日誌"
                            )
                            .setColor("#43b581");

                        await guild.channels.cache
                        .get(LogsChannel.id)
                        .send({ embeds: [LogsSetup] })
                        .then((m) => {
                            setTimeout(() => {
                                m.delete().catch(() => {});
                            }, 1 * 7500);
                        });

                        await interaction.reply({
                            content: "完成",
                            ephemeral: true,
                        });
                    }
                    break;
                case "reset":
                    {
                        const LogsReset = new EmbedBuilder()
                            .setDescription(
                                "✅ | 成功重置日誌頻道"
                            )
                            .setColor("#43b581");
                        DB.deleteMany({ GuildID: guild.id }, async(err, data) => {
                            if (err) throw err;
                            if (!data)
                                return interaction.reply({
                                    content: "沒有要刪除的數據",
                                });
                            interaction.reply({ embeds: [LogsReset] });
                        });
                    }
                    return;
            }
        } catch (e) {
            const errorEmbed = new EmbedBuilder()
                .setColor("#f04947")
                .setDescription(`<a:Error:934736751740715009> 錯誤: ${e}`);
            return interaction.reply({
                embeds: [errorEmbed],
                ephemeral: false,
            });
        }
    },
};