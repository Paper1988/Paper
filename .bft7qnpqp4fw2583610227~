const { CommandInteraction, EmbedBuilder, SlashCommandBuilder, PermissionFlagsBits } = require("discord.js");

module.exports = {
	data: new SlashCommandBuilder()
  .setName("announce")
  .setDescription("通過機器人公告某事!")
  .setDefaultMemberPermissions(PermissionFlagsBits.ModerateMessages)
  .addStringOption(option =>
		option
			.setName('title')
			.setDescription('將您的公告標題放在這裡!')
			.setRequired(true)
	)
	.addStringOption(option =>
		option
			.setName('message')
			.setDescription('顯示您要宣布的消息!')
			.setRequired(true)
	)
	.addStringOption(option =>
		option
			.setName('color')
			.setDescription('自定義您的嵌入顏色')
			.setRequired(false)
	)
	.addStringOption(option =>
		option
			.setName('footer')
			.setDescription('為您的公告添加頁腳')
			.setRequired(false)
	)
	.addBooleanOption(option =>
		option
			.setName('timestamp')
			.setDescription('是否啟用時間戳?')
			.setRequired(false)
	)
	.addStringOption(option =>
		option
			.setName('ping')
			.setDescription('對您的公告消息的附加 ping')
			.setRequired(false)
	    .addChoices(
				{	name: "@everyone", value: "@everyone" },
        	{ name: "@here", value: "@here" }
		)
  ),
  /**
    *
    * @param {CommandInteraction} interaction
    */
  execute(interaction) {
    const { options, user } = interaction;
    const title = options.getString("title");
    const message = options.getString("message");
    const color = options.getString("color");
    const footer = options.getString("footer");
    const timestamp = options.getBoolean("timestamp");
    const ping = options.getString("ping");
    const embed = new EmbedBuilder()
    	.setAuthor({name: `${user.tag}`, iconURL: `${user.displayAvatarURL({dynamic: true})}`})
	    .setTitle(`${title}`)
	    .setDescription(`${message}`)

    if(color) embed.setColor(color.toUpperCase());
    if(footer) embed.setFooter({ text: footer });
    if(timestamp) embed.setTimestamp();

    if (!ping) {
      interaction.reply({
        embeds: [embed]
      });
    } else {
      interaction.reply({
        content: `${ping === "@everyone" ? "@everyone" : "@here"}`,
        embeds: [embed],
        allowedMentions: {
          parse: ['everyone']
        }
      });
    }
  }
}