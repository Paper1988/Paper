const { CommandInteraction, SlashCommandBuilder } = require("discord.js");

module.exports = {
    data: new SlashCommandBuilder()
        .setName("ping")
        .setDescription("Pong!"),
    usage: "/ping",
    /**
     * @param {CommandInteraction} interaction
     */
    execute(interaction) {
        interaction.reply("Pong!");
    }
}