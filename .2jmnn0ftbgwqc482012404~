const { CommandInteraction, EmbedBuilder, Client } = require("discord.js");

module.exports = {
        name: "music",
        description: "一個完善的音樂系統",
        permission: "ADMINISTRATOR",
        usage: "/music (play, volume, settings)",
        options: [{
                name: "play",
                description: "播放音樂",
                type: "SUB_COMMAND",
                options: [{
                    name: "query",
                    description: "請提供一個歌名或連結",
                    type: "STRING",
                    required: true,
                }],
            },
            {
                name: "volume",
                description: "調整音量大小",
                type: "SUB_COMMAND",
                options: [{
                    name: "percent",
                    description: "1 = 1%",
                    type: "NUMBER",
                    required: true,
                }],
            },
						{
	            name: "seek",
	            description: "跳到指定位置",
	            type: "SUB_COMMAND",
	            options: [
	                {
	                    name: "time",
	                    description: "提供要跳到的位置（以秒為單位）",
	                    type: "NUMBER",
	                    required: true,
	                },
	            ],
        		},
        		{
	            name: "filters",
	            description: "切換過濾器",
	            type: "SUB_COMMAND",
	            options: [{
								name: "set",
								description: "選擇一個過濾器",
								type: "STRING",
								required: true,
	            	choices: [
	                {name: "🔌 關閉所有過濾器", value: "false"},
	                {name: "📣 切換 8d 過濾器", value: "8d"},
	                {name: "📣 切換 低音增強 過濾器", value: "bassboost"},
	                {name: "📣 切換 迴聲 過濾器", value: "echo"},
	                {name: "📣 切換 nightcore 過濾器", value: "nightcore"},
	                {name: "📣 切換 surround 過濾器", value: "surround"},
	                {name: "📣 切換 karaoke 過濾器", value: "karaoke"},
	                {name: "📣 切換 vaporwave 過濾器", value: "vaporwave"},
	                {name: "📣 切換 flanger 過濾器", value: "flanger"},
	                {name: "📣 切換 gate 過濾器", value: "gate"},
	                {name: "📣 切換 haas 過濾器", value: "haas"},
	                {name: "📣 切換 reverse 過濾器", value: "reverse"},
	                {name: "📣 切換 mcompand 過濾器", value: "mcompand"},
	                {name: "📣 切換 phaser 過濾器", value: "phaser"},
	                {name: "📣 切換 tremolo 過濾器", value: "tremolo"},
	                {name: "📣 切換 earwax 過濾器", value: "earwax"},
	            	],
							}],
						},
            {
                name: "settings",
                description: "選擇一個選項",
                type: "SUB_COMMAND",
                options: [{
                    name: "options",
                    description: "選擇一個選項",
                    type: "STRING",
                    required: true,
                    choices: [
                        { name: "🔢 顯示播放清單", value: "queue" },
                        { name: "⏭ 跳過歌曲", value: "skip" },
                        { name: "⏸ 暫停播放歌曲", value: "pause" },
                        { name: "▶ 繼續播放歌曲", value: "resume" },
                        { name: "⏹ 停止音樂", value: "stop" },
                        { name: "🔀 隨機播放", value: "shuffle" },
                        { name: "🔃 切換自動播放", value: "autoplay" },
                        { name: "🈁 添加相關歌曲", value: "related" },
                        { name: "🔁 切換重複播放", value: "repeat" },
												{ name: "⏮ 播放上一首曲目", value: "previous" },
                    ]
                }]
            }
        ],
        /**
         * @param {CommandInteraction} interaction
         * @param {Client} client
         */
        async execute(interaction, client) {
            const { options, member, guild, channel } = interaction;
            const VoiceChannel = member.voice.channel;

            if (!VoiceChannel)
                return interaction.reply({ content: "> 你必須待在一個語音頻道裡面才能使用音樂指令!", ephemeral: true });
            if (guild.me.voice.channelId && VoiceChannel.id !== guild.me.voice.channelId)
                return interaction.reply({ content: `> 我已經在語音頻道 - <#${guild.me.voice.channelId}> 裡播放音樂了`, ephemeral: true });

            try {
                switch (options.getSubcommand()) {
                    case "play":
                        {
                            client.distube.play(VoiceChannel, options.getString("query"), { textChannel: channel, member: member });
                            return interaction.reply({ content: "> 🎼 請求已接受" });
                        }
                    case "volume":
                        {
                            const Volume = options.getNumber("percent");
                            if (Volume > 100 || Volume < 1)
                                return interaction.reply({ content: "> 你必須指定1到100之間的數字!" });

                            client.distube.setVolume(VoiceChannel, Volume);
                            return interaction.reply({ content: `> 📶 成功設置音量為 \`${Volume}%\`` })
                        }
										case "seek" : 
												{
				                    const queue = await client.distube.getQueue(VoiceChannel);
				                    const Time = options.getNumber("time");
				
				                    if(!queue)
				                    		return interaction.reply({ content: "⛔ 找不到清單" });
				
				                    await queue.seek(Time);
				                    return interaction.reply({content: `⏩ **跳到 \`${Time}\`**`});
		                		}
                    case "settings":
                        {
                            const queue = await client.distube.getQueue(VoiceChannel);

                            if (!queue)
                                return interaction.reply({ content: "⛔ 找不到清單" });

                            switch (options.getString("options")) {
                                case "skip":
                                    await queue.skip(VoiceChannel);
                                    return interaction.reply({ content: "> ⏭ 成功跳過歌曲" });

                                case "stop":
                                    await queue.stop(VoiceChannel);
                                    return interaction.reply({ content: "> ⏹ 成功停止音樂並退出語音頻道" });

                                case "pause":
                                    await queue.pause(VoiceChannel);
                                    return interaction.reply({ content: "> ⏸ 成功暫停播放歌曲" });

                                case "resume":
                                    await queue.resume(VoiceChannel);
                                    return interaction.reply({ content: "> ▶ 成功繼續播放歌曲" });

                                case "shuffle":
                                    await queue.shuffle(VoiceChannel);
                                    return interaction.reply({ content: "> 🔀 成功隨機播放歌曲" });

                                case "autoplay":
                                    let Mode = await queue.toggleAutoplay(VoiceChannel);
                                    return interaction.reply({ content: `> 🔃 成功切換自動播放模式為: ${Mode ? "開" : "關"}` });

																case "previous" :
						                        await queue.previous(VoiceChannel);
						                        return interaction.reply({content: "> ⏮ 成功播放上一首曲目"});

                                case "related":
                                    await queue.addRelatedSong(VoiceChannel);
                                    return interaction.reply({ content: "> 🈁 成功添加一個相關歌曲到播放清單中" });

                                case "repeat":
                                    let Mode2 = await client.distube.setRepeatMode(queue);
                                    return interaction.reply({ content: `> 🔃 成功切換重複播放模式為: \`${Mode2 = Mode2 ? Mode2 == 2 ? '整個清單' : '單曲' : '關閉'}\`` });

                                case "queue":
                                    return interaction.reply({
                                                embeds: [new EmbedBuilder()
                                                        .setColor("PURPLE")
																												 .setDescription(`${queue.songs.slice(0, 10).map((song, id) => `\n**${id + 1}**. ${song.name} - \`${song.formattedDuration}\``)}`)]});
					}
					return;
				}
				case "filters" : {
                    const queue = await client.distube.getQueue(VoiceChannel);

                    if(!queue)
                    return interaction.reply({content: "⛔ 找不到清單"});

                    switch(options.getString("set")) {
                        case "false" : 
                        await queue.setFilter(false);
                        return interaction.reply({content: `❎ 成功禁用所有過濾器`});

                        case "8d" : 
                        await queue.setFilter(`3d`);
                        return interaction.reply({content: `✅ 成功切換到 8D 過濾器`});

                        case "karaoke" : 
                        await queue.setFilter(`karaoke`);
                        return interaction.reply({content: `✅ 成功切換到 OK 過濾器`});
                        
                        case "vaporwave" : 
                        await queue.setFilter(`vaporwave`);
                        return interaction.reply({content: `✅ 成功切換到 蒸汽波 過濾器`});

                        case "flanger" : 
                        await queue.setFilter(`flanger`);
                        return interaction.reply({content: `✅ 成功切換到 鑲邊 過濾器`});

                        case "gate" : 
                        await queue.setFilter(`gate`);
                        return interaction.reply({content: `✅ 成功切換到 門 過濾器`});

                        case "haas" : 
                        await queue.setFilter(`haas`);
                        return interaction.reply({content: `✅ 成功切換到 haas 過濾器`});

                        case "reverse" : 
                        await queue.setFilter(`reverse`);
                        return interaction.reply({content: `✅ 成功切換到 反向 過濾器`});

                        case "mcompand" : 
                        await queue.setFilter(`mcompand`);
                        return interaction.reply({content: `✅ 成功切換到 mcompand 過濾器`});

                        case "phaser" : 
                        await queue.setFilter(`phaser`);
                        return interaction.reply({content: `✅ 成功切換到 移相器 過濾器`});

                        case "tremolo" : 
                        await queue.setFilter(`tremolo`);
                        return interaction.reply({content: `✅ 成功切換到 顫音 過濾器`});

                        case "earwax" : 
                        await queue.setFilter(`earwax`);
                        return interaction.reply({content: `✅ 成功切換到 耳垢 過濾器`});

                        case "bassboost" : 
                        await queue.setFilter(`bassboost`);
                        return interaction.reply({content: `✅ 成功切換到 低音增強 過濾器`});
                        
                        case "echo" : 
                        await queue.setFilter(`echo`);
                        return interaction.reply({content: `✅ 成功切換到 迴聲 過濾器`});
                        
                        case "nightcore" : 
	                        await queue.setFilter(`nightcore`);
	                        return interaction.reply({content: `✅ 成功切換到 nightcore 過濾器`});
                        
                        case "surround" : 
                        await queue.setFilter(`surround`);
                        return interaction.reply({content: `✅ 成功切換到 環繞聲 過濾器`});      
                    }
						}
				}
		} catch (e) {
			const errorEmbed = new EmbedBuilder()
			.setColor("RED")
			.setDescription(`⛔ 錯誤: ${e}`)

			return interaction.reply({embeds: [errorEmbed]});
		}
	}
}