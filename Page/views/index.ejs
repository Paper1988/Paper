<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://paper-bot.statuspage.io/embed/script.js"></script>
    <title>Paper-Bot | Home</title>
    <style>
        .container {
            width: 100%;
            height: 100%;
        }

        .header {
            background-color: #36393f;
            color: #ffffff;
            text-align: center;
        }

        .header-h1 {
            padding: 20px;
            text-align: left;
            font-size: 25px;
        }

        .content {
            padding: 20px;
        }

        .status {
            display: flex;
            flex-wrap: wrap;
        }

        .box {
            width: 33%;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            text-align: center;
        }

        .title {
            font-weight: bold;
        }

        .value {
            font-size: 18px;
        }

        .buttons {
            display: flex;
            text-align: center;
        }

        a {
            margin: 0 10px;
            padding: 10px 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            text-decoration: none;
            color: #36393f;
        }

        a:hover {
            background-color: #36393f;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1 class="header-h1">Paper Bot</h1>
        </div>
        <div class="content">
            <div class="status">
                <div class="box">
                    <div class="title">狀態</div>
                    <div class="value">{{ client.status }}</div>
                </div>
                <div class="box">
                    <div class="title">伺服器數量</div>
                    <div class="value">{{ client.guilds.cache.size }}</div>
                </div>
                <div class="box">
                    <div class="title">使用者數量</div>
                    <div class="value">{{ client.users.cache.size }}</div>
                </div>
            </div>
            <div class="buttons">
                <a href="/api/guild/:guildId">伺服器</a>
                <a href="/login">登入</a>
            </div>
        </div>
    </div>
    <footer>
        <a href="/tp">隱私權政策&使用者條款</a>
    </footer>
</body>
</html>