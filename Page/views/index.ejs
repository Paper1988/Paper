<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paper Bot Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <div class="container">
            <h1>Paper Bot Dashboard</h1>
            <p>Your go-to place for managing Paper Bot</p>
        </div>
    </header>

    <section class="container">
        <div class="bot-info">
            <h2>Bot Information</h2>
            <p><strong>Bot Name:</strong> Paper</p>
            <p><strong>Status:</strong> Online</p>
        </div>
    </section>

    <section class="container">
        <div class="server-settings">
            <h2>Server Settings</h2>
            <form action="/dashboard" method="post">
                <label for="guildId">Guild ID:</label>
                <input type="text" id="guildId" name="guildId" required>
                <button type="submit">儲存設定</button>
            </form>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; 2024 Paper Bot. All rights reserved.</p>
        </div>
    </footer>

</body>

</html>