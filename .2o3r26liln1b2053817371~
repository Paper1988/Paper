const { EmbedBuilder, CommandInteraction, Client, PermissionFlagsBits } = require("discord.js");
const ms = require('ms');

module.exports = {
    subCommand: "giveaway.start",
    /**
     * @param {Client} client
     * @param {CommandInteraction} Interaction
     */
    execute(client, interaction) {
        const { options } = interaction;

        const sub = options.getSubcommand();

        const errEmbed = new EmbedBuilder()
            .setColor("RED");

        const successEmbed = new EmbedBuilder()
            .setColor("GREEN");

        const gchannel = options.getChannel("channel") || interaction.channel;
        const duration = options.getString("duration");
        const winnerCount = options.getInteger("winners");
        const prize = options.getString("prize");

        client.giveawaysManager.start(gchannel, {
            duration: ms(duration),
            winnerCount,
            prize,
            messages: {
                giveaway: "🎉**抽獎活動開始了**🎉",
                giveawayEnded: "🎊**抽獎活動結束了**🎊",
                inviteToParticipate: "**點擊🎉反應來參加抽獎!**",
                winMessage: "恭喜贏家 {winners} 獲得獎品: **\`{this.prize}\`**",
                noWinner: "抽獎活動取消，發生錯誤: \`參與人數不足\`",
                dropMessage: "成為第一位參加的人!",
                drawing: "剩餘時間: {timestamp}",
                winners: "贏家:",
                endedAt: "結束時間",
                hostedBy: "舉辦人: {this.hostedBy}",
                embedFooter: "{this.winnerCount} 位贏家"
            }
        }).then(async() => {
            successEmbed.setDescription("抽獎活動成功開始!");
            return interaction.reply({ embeds: [successEmbed] });
        }).catch((err) => {
            successEmbed.setDescription(`發生錯誤:\n\`${err}\``);
            return interaction.reply({ embeds: [errEmbed] });
        })
    }
}