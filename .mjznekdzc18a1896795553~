const { Client, CommandInteraction, EmbedBuilder, ActionRowBuilder, ButtonBuilder, SlashCommandBuilder } = require("discord.js");
const malScraper = require('mal-scraper');

module.exports = {
		data: new SlashCommandBuilder()
    	.setName("animesearch")
	    .setDescription("獲取有關動漫的訊息")
	    .addStringOption(options =>
	        options
				.setName("name")
	        	.setDescription("您要搜尋的動漫名稱")
		        .setRequired(true)
			),
    usage: "/anime <anime name>",
    /**
     *
     * @param {Client} client
     * @param {CommandInteraction} interaction
     */
    async execute(interaction, client) {
        await interaction.deferReply();
        const name = interaction.options.getString("name");
        const search = name;

        malScraper.getInfoFromName(search)
            .then((data) => {
                const malEmbed = new EmbedBuilder()
                    .setAuthor({ name: `我的動漫列表搜索結果: ${data.title}`.split(',').join(' ') })
                    .setThumbnail(data.picture)
                    .setColor('RANDOM') //What ever u want color!
                    .setDescription(data.synopsis)
                    .addField('首映', `${data.premiered}`, true)
                    .addField('播送', `${data.broadcast}`, true)
                    .addField('流派', `${data.genres}`, true)
                    .addField('英文標題', `${data.englishTitle}`, true)
                    .addField('日文標題', `${data.japaneseTitle}`, true)
                    .addField('類型', `${data.type}`, true)
                    .addField('集數', `${data.episodes}`, true)
                    .addField('評價', `${data.rating}`, true)
                    .addField('播出', `${data.aired}`, true)
                    .addField('分數', `${data.score}`, true)
                    .addField('最喜歡的', `${data.favorites}`, true)
                    .addField('排名', `${data.ranked}`, true)
                    .addField('期間', `${data.duration}`, true)
                    .addField('工作室', `${data.studios}`, true)
                    .addField('人氣', `${data.popularity}`, true)
                    .addField('觀看人數', `${data.members}`, true)
                    .addField('得分統計', `${data.scoreStats}`, true)
                    .addField('來源', `${data.source}`, true)
                    .addField('關鍵字', `\`${data.synonyms}\``, true)
                    .addField('狀態', `${data.status}`, true)
                    .addField('識別碼', `${data.id}`, true)
                    .addField('連結', data.url, true)
                    .setTimestamp()
                const row = new ActionRowBuilder()
                    .addComponents(
                        new ButtonBuilder()
                        .setStyle("LINK")
                        .setURL(data.url)
                        .setLabel("MyAnimeList - " + data.title)
                    );

                interaction.editReply({ embeds: [malEmbed], components: [row] });
            })
            .catch((err) => {
                console.log(err)
                return interaction.editReply({
                    content: "找不到該動漫!"
                });
            });
    },
};
