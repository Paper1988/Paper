# Discord Bot Configuration
DISCORD_TOKEN=your_production_discord_bot_token
TEST_TOKEN=your_development_discord_bot_token

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/your_database_name

# Redis Configuration (Optional - will use in-memory cache if not provided)
REDIS_URL=redis://localhost:6379

# Sentry Configuration (Optional)
SENTRY_DNS=your_sentry_dsn_url

# Music Service API Keys (Optional)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_OAUTH_TOKEN=your_soundcloud_oauth_token

# Webhook Configuration (Optional)
ANTICRASH_WEBHOOK_URL=your_error_webhook_url

# Bot Configuration
NODE_ENV=development
PORT=3001

# Status Notification Configuration (Required for production notifications)
STATUS_WEBHOOK_ID=your_status_webhook_id
STATUS_WEBHOOK_TOKEN=your_status_webhook_token
PRODUCTION_BOT_ID=your_production_bot_user_id

# Feedback System Configuration (Required for feedback command)
FEEDBACK_CHANNEL_ID=your_feedback_channel_id